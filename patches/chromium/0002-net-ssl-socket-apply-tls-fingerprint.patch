From: Custom TLS Fingerprint <noreply@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH 2/4] net/socket: apply TLSFingerprintParams in SSLClientSocketImpl

Adds ApplyTLSFingerprintIfEnabled() called at the end of
SSLClientSocketImpl::Init(), just before returning OK.  Reads the
TLSFingerprintManager singleton and overrides BoringSSL settings on the
per-connection SSL* object.

Also declares the helper in the class private section.
---
 net/socket/ssl_client_socket_impl.cc | 67 ++++++++++++++++++++++++++++
 net/socket/ssl_client_socket_impl.h  |  1 +
 2 files changed, 68 insertions(+)

diff --git a/net/socket/ssl_client_socket_impl.cc b/net/socket/ssl_client_socket_impl.cc
index 00000000..11111111 100644
--- a/net/socket/ssl_client_socket_impl.cc
+++ b/net/socket/ssl_client_socket_impl.cc
@@ -61,6 +61,7 @@
 #include "net/ssl/ssl_key_logger.h"
 #include "net/ssl/ssl_private_key.h"
+#include "net/ssl/tls_fingerprint_config.h"
 #include "net/traffic_annotation/network_traffic_annotation.h"
 #include "third_party/boringssl/src/include/openssl/bio.h"
 #include "third_party/boringssl/src/include/openssl/bytestring.h"
@@ -843,9 +843,75 @@
       !SSL_set1_requested_trust_anchors(ssl_.get(),
                                         ssl_config_.trust_anchor_ids->data(),
                                         ssl_config_.trust_anchor_ids->size())) {
     return ERR_UNEXPECTED;
   }

+  // Apply custom TLS fingerprint if configured via CDP setTLSFingerprint.
+  ApplyTLSFingerprintIfEnabled();
+
   return OK;
 }

+void SSLClientSocketImpl::ApplyTLSFingerprintIfEnabled() {
+  TLSFingerprintManager* mgr = TLSFingerprintManager::GetInstance();
+  if (!mgr->IsEnabled()) {
+    return;
+  }
+  TLSFingerprintParams fp = mgr->GetParams();
+
+  // TLS version limits.
+  if (fp.min_version != 0) {
+    SSL_set_min_proto_version(ssl_.get(),
+                              static_cast<uint16_t>(fp.min_version));
+  }
+  if (fp.max_version != 0) {
+    SSL_set_max_proto_version(ssl_.get(),
+                              static_cast<uint16_t>(fp.max_version));
+  }
+
+  // Cipher suites: split TLS 1.3 (0x1300-0x13FF) from TLS <=1.2.
+  if (!fp.cipher_suites.empty()) {
+    std::string tls13_names;
+    std::string tls12_names;
+    for (uint16_t id : fp.cipher_suites) {
+      const char* name = CipherSuiteIANAToBoringSSL(id);
+      if (!name) continue;
+      if (id >= 0x1300 && id <= 0x13FF) {
+        if (!tls13_names.empty()) tls13_names += ':';
+        tls13_names += name;
+      } else {
+        if (!tls12_names.empty()) tls12_names += ':';
+        tls12_names += name;
+      }
+    }
+    if (!tls12_names.empty())
+      SSL_set_cipher_list(ssl_.get(), tls12_names.c_str());
+    if (!tls13_names.empty())
+      SSL_set_ciphersuites(ssl_.get(), tls13_names.c_str());
+  }
+
+  // Supported EC groups (IANA NamedGroup values).
+  if (!fp.supported_groups.empty()) {
+    SSL_set1_groups(ssl_.get(),
+                    fp.supported_groups.data(),
+                    fp.supported_groups.size());
+  }
+
+  // Extension ordering / permutation.
+  if (fp.permute_extensions) {
+    SSL_set_permute_extensions(ssl_.get(), 1);
+  } else if (!fp.extension_order.empty()) {
+    SSL_set_extension_order(ssl_.get(),
+                            fp.extension_order.data(),
+                            fp.extension_order.size());
+  }
+}
+
 void SSLClientSocketImpl::DoReadCallback(int rv) {
diff --git a/net/socket/ssl_client_socket_impl.h b/net/socket/ssl_client_socket_impl.h
index 00000000..11111111 100644
--- a/net/socket/ssl_client_socket_impl.h
+++ b/net/socket/ssl_client_socket_impl.h
@@ -130,6 +130,7 @@
     FRIEND_TEST_ALL_PREFIXES(SSLClientSocketTest, ParseServerTrustAnchorIDs);

     int Init();
+    void ApplyTLSFingerprintIfEnabled();
     void DoReadCallback(int result);
     void DoWriteCallback(int result);

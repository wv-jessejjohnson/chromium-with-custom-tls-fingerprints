diff --git a/content/browser/devtools/protocol/emulation_handler.cc b/content/browser/devtools/protocol/emulation_handler.cc
index 55556666..77778888 100644
--- a/content/browser/devtools/protocol/emulation_handler.cc
+++ b/content/browser/devtools/protocol/emulation_handler.cc
@@ -35,7 +35,106 @@
 #include "content/browser/renderer_host/render_frame_host_impl.h"
 #include "content/public/browser/browser_thread.h"
 #include "content/public/browser/web_contents.h"
+#include "net/ssl/tls_fingerprint_config.h"
+#include "services/network/public/mojom/tls_fingerprint.mojom.h"
 
 namespace content {
 namespace protocol {
 
+// ── Emulation.setTLSFingerprint ─────────────────────────────────────────────
+
+protocol::Response EmulationHandler::SetTLSFingerprint(
+    protocol::Maybe<std::string> ja3_string,
+    protocol::Maybe<std::vector<int>> cipher_suites_in,
+    protocol::Maybe<std::vector<int>> supported_groups_in,
+    protocol::Maybe<std::vector<int>> extension_order_in,
+    protocol::Maybe<bool> permute_extensions,
+    protocol::Maybe<int> min_version,
+    protocol::Maybe<int> max_version) {
+
+  net::TLSFingerprintParams params;
+
+  // Start from JA3 string if provided.
+  if (ja3_string.isJust()) {
+    params = net::ParseJA3String(ja3_string.fromJust());
+  }
+
+  // Individual fields override ja3String values.
+  if (cipher_suites_in.isJust()) {
+    params.cipher_suites.clear();
+    for (int v : cipher_suites_in.fromJust()) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.cipher_suites.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (supported_groups_in.isJust()) {
+    params.supported_groups.clear();
+    for (int v : supported_groups_in.fromJust()) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.supported_groups.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (extension_order_in.isJust()) {
+    params.extension_order.clear();
+    for (int v : extension_order_in.fromJust()) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.extension_order.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (permute_extensions.isJust()) {
+    params.permute_extensions = permute_extensions.fromJust();
+  }
+  if (min_version.isJust() && min_version.fromJust() > 0) {
+    params.min_version = static_cast<uint16_t>(min_version.fromJust());
+  }
+  if (max_version.isJust() && max_version.fromJust() > 0) {
+    params.max_version = static_cast<uint16_t>(max_version.fromJust());
+  }
+  params.enabled = true;
+
+  // Push to the network service via Mojo.
+  // GetNetworkService() is available in the browser process; the call is
+  // async but we return success immediately — the setting is applied before
+  // the next connection attempt.
+  auto* storage_partition =
+      host_ ? host_->GetStoragePartition() : nullptr;
+  if (storage_partition) {
+    auto* network_context = storage_partition->GetNetworkContext();
+    if (network_context) {
+      auto mojo_params = network::mojom::TLSFingerprintParams::New();
+      mojo_params->min_version      = params.min_version;
+      mojo_params->max_version      = params.max_version;
+      mojo_params->cipher_suites    = params.cipher_suites;
+      mojo_params->supported_groups = params.supported_groups;
+      mojo_params->ec_point_formats = params.ec_point_formats;
+      mojo_params->extension_order  = params.extension_order;
+      mojo_params->permute_extensions = params.permute_extensions;
+      mojo_params->enabled          = true;
+      // network_context->SetTLSFingerprintParams(std::move(mojo_params),
+      //     base::DoNothing());
+      // NOTE: wire this call after adding SetTLSFingerprintParams to
+      //       NetworkContext's Mojo interface (see patch 0003 comments).
+    }
+  }
+
+  // Also update the in-process singleton so unit tests work without IPC.
+  net::TLSFingerprintManager::GetInstance()->SetParams(params);
+
+  return protocol::Response::Success();
+}
+
+protocol::Response EmulationHandler::ResetTLSFingerprint() {
+  net::TLSFingerprintManager::GetInstance()->Reset();
+
+  // Propagate reset to network service.
+  auto* storage_partition =
+      host_ ? host_->GetStoragePartition() : nullptr;
+  if (storage_partition) {
+    auto* network_context = storage_partition->GetNetworkContext();
+    if (network_context) {
+      // network_context->ResetTLSFingerprintParams(base::DoNothing());
+    }
+  }
+
+  return protocol::Response::Success();
+}

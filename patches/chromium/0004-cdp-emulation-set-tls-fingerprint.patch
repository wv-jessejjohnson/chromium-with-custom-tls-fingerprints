+protocol::Response EmulationHandler::SetTLSFingerprint(
+    std::optional<std::string> ja3_string,
+    std::unique_ptr<protocol::Array<int>> cipher_suites_in,
+    std::unique_ptr<protocol::Array<int>> supported_groups_in,
+    std::unique_ptr<protocol::Array<int>> extension_order_in,
+    std::optional<bool> permute_extensions,
+    std::optional<int> min_version,
+    std::optional<int> max_version) {
+  net::TLSFingerprintParams params;
+  if (ja3_string.has_value()) {
+    params = net::ParseJA3String(*ja3_string);
+  }
+  if (cipher_suites_in) {
+    params.cipher_suites.clear();
+    for (int v : *cipher_suites_in) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.cipher_suites.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (supported_groups_in) {
+    params.supported_groups.clear();
+    for (int v : *supported_groups_in) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.supported_groups.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (extension_order_in) {
+    params.extension_order.clear();
+    for (int v : *extension_order_in) {
+      if (v >= 0 && v <= 0xFFFF)
+        params.extension_order.push_back(static_cast<uint16_t>(v));
+    }
+  }
+  if (permute_extensions.has_value()) {
+    params.permute_extensions = *permute_extensions;
+  }
+  if (min_version.has_value() && *min_version > 0) {
+    params.min_version = static_cast<uint16_t>(*min_version);
+  }
+  if (max_version.has_value() && *max_version > 0) {
+    params.max_version = static_cast<uint16_t>(*max_version);
+  }
+  params.enabled = true;
+  content::GetNetworkService()->SetTLSFingerprint(
+      params.min_version, params.max_version,
+      params.cipher_suites, params.supported_groups,
+      params.ec_point_formats, params.extension_order,
+      params.permute_extensions, params.enabled,
+      base::DoNothing());
+  return protocol::Response::Success();
+}
+
+protocol::Response EmulationHandler::ResetTLSFingerprint() {
+  content::GetNetworkService()->ResetTLSFingerprint(base::DoNothing());
+  return protocol::Response::Success();
+}

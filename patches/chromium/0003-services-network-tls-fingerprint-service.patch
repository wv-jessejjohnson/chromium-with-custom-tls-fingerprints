--- /dev/null
+++ b/services/network/tls_fingerprint_service_impl.cc
@@ -0,0 +1,49 @@
+// Copyright 2024 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "services/network/tls_fingerprint_service_impl.h"
+
+#include "net/ssl/tls_fingerprint_config.h"
+
+namespace network {
+
+namespace {
+
+// Converts the Mojo struct to the net:: struct.
+net::TLSFingerprintParams FromMojo(
+    const mojom::TLSFingerprintParams& mojo) {
+  net::TLSFingerprintParams p;
+  p.min_version = mojo.min_version;
+  p.max_version = mojo.max_version;
+  p.cipher_suites =
+      std::vector<uint16_t>(mojo.cipher_suites.begin(),
+                            mojo.cipher_suites.end());
+  p.supported_groups =
+      std::vector<uint16_t>(mojo.supported_groups.begin(),
+                            mojo.supported_groups.end());
+  p.ec_point_formats =
+      std::vector<uint8_t>(mojo.ec_point_formats.begin(),
+                           mojo.ec_point_formats.end());
+  p.extension_order =
+      std::vector<uint16_t>(mojo.extension_order.begin(),
+                            mojo.extension_order.end());
+  p.permute_extensions = mojo.permute_extensions;
+  p.enabled = mojo.enabled;
+  return p;
+}
+
+}  // namespace
+
+void TLSFingerprintServiceImpl::SetParams(
+    mojom::TLSFingerprintParamsPtr params,
+    SetParamsCallback callback) {
+  net::TLSFingerprintManager::GetInstance()->SetParams(FromMojo(*params));
+  std::move(callback).Run();
+}
+
+void TLSFingerprintServiceImpl::Reset(ResetCallback callback) {
+  net::TLSFingerprintManager::GetInstance()->Reset();
+  std::move(callback).Run();
+}
+
+}  // namespace network

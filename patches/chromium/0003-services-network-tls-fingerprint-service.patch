From: Custom TLS Fingerprint <noreply@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH 3/5] services/network: expose TLSFingerprintService via Mojo

Adds a new Mojo interface (tls_fingerprint.mojom) to the network service that
lets the browser process push TLS fingerprint parameters to the network
service process at runtime (without restart).

Changes:
  1. services/network/public/mojom/network_service.mojom  — add BindTLSFingerprintService()
  2. services/network/network_service.cc/.h               — implement binding
  3. services/network/tls_fingerprint_service_impl.cc/.h  — new impl (copy from src/)
  4. services/network/BUILD.gn                            — wire everything up

After applying this patch, copy:
  src/chromium/services/network/public/mojom/tls_fingerprint.mojom
  → services/network/public/mojom/tls_fingerprint.mojom
---
 services/network/BUILD.gn                             |  8 +++++
 services/network/network_service.cc                   | 20 +++++++++++++
 services/network/network_service.h                    |  7 +++++
 services/network/public/mojom/network_service.mojom   |  6 ++++
 services/network/tls_fingerprint_service_impl.cc      | 48 +++++++++++++++++++++++++++++++
 services/network/tls_fingerprint_service_impl.h       | 32 +++++++++++++++++++++
 6 files changed, 121 insertions(+)

diff --git a/services/network/BUILD.gn b/services/network/BUILD.gn
index aaaabbbb..ccccdddd 100644
--- a/services/network/BUILD.gn
+++ b/services/network/BUILD.gn
@@ -200,9 +200,17 @@ component("network_service") {
   sources = [
     # ... existing sources ...
+    "tls_fingerprint_service_impl.cc",
+    "tls_fingerprint_service_impl.h",
   ]
   deps = [
     # ... existing deps ...
+    "//net/ssl:ssl",  # for TLSFingerprintManager
   ]
 }
 
+# Mojom for TLS fingerprint IPC
+mojom("tls_fingerprint_mojom") {
+  sources = [ "public/mojom/tls_fingerprint.mojom" ]
+  public_deps = [ "//mojo/public/mojom/base" ]
+}
 
diff --git a/services/network/network_service.mojom b/services/network/public/mojom/network_service.mojom
index eeeeffff..00001111 100644
--- a/services/network/public/mojom/network_service.mojom
+++ b/services/network/public/mojom/network_service.mojom
@@ -10,8 +10,14 @@ import "services/network/public/mojom/network_context.mojom";
 import "services/network/public/mojom/network_types.mojom";
 import "services/network/public/mojom/url_loader.mojom";
 import "services/network/public/mojom/url_loader_factory.mojom";
+import "services/network/public/mojom/tls_fingerprint.mojom";
 
 interface NetworkService {
   // ... existing methods ...
+
+  // Binds the TLS fingerprint configuration service.
+  // Call once at browser startup; the receiver lives for the service lifetime.
+  BindTLSFingerprintService(
+      pending_receiver<TLSFingerprintService> receiver);
 };
 
diff --git a/services/network/network_service.h b/services/network/network_service.h
index 22223333..44445555 100644
--- a/services/network/network_service.h
+++ b/services/network/network_service.h
@@ -55,5 +55,12 @@ class NetworkService : public mojom::NetworkService {
   // ... existing declarations ...
 
+  // mojom::NetworkService:
+  void BindTLSFingerprintService(
+      mojo::PendingReceiver<mojom::TLSFingerprintService> receiver) override;
+
  private:
+  std::unique_ptr<TLSFingerprintServiceImpl> tls_fingerprint_service_;
+  mojo::Receiver<mojom::TLSFingerprintService>
+      tls_fingerprint_receiver_{nullptr};
 };
 
diff --git a/services/network/network_service.cc b/services/network/network_service.cc
index 66667777..88889999 100644
--- a/services/network/network_service.cc
+++ b/services/network/network_service.cc
@@ -30,5 +30,17 @@
 #include "services/network/network_service.h"
+#include "services/network/tls_fingerprint_service_impl.h"
 
 // ... existing code ...
 
+void NetworkService::BindTLSFingerprintService(
+    mojo::PendingReceiver<mojom::TLSFingerprintService> receiver) {
+  if (!tls_fingerprint_service_) {
+    tls_fingerprint_service_ = std::make_unique<TLSFingerprintServiceImpl>();
+  }
+  tls_fingerprint_receiver_.Bind(std::move(receiver));
+  tls_fingerprint_receiver_.set_disconnect_handler(base::BindOnce(
+      [](NetworkService* svc) {
+        svc->tls_fingerprint_service_.reset();
+      }, base::Unretained(this)));
+}
 

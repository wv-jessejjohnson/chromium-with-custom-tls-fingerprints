From: Custom TLS Fingerprint <noreply@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH 3/4] services/network: expose SetTLSFingerprint on NetworkService Mojo

Adds two methods to the NetworkService Mojo interface so the browser
process can push TLS fingerprint params to the network service process:

  NetworkService::SetTLSFingerprint(...)  — activate custom fingerprint
  NetworkService::ResetTLSFingerprint()   — revert to Chromium defaults

Both methods delegate to net::TLSFingerprintManager, the per-process
singleton read by SSLClientSocketImpl on every new connection.
---
 services/network/network_service.cc                 | 37 +++++++++++++
 services/network/network_service.h                  |  9 ++++
 services/network/public/mojom/network_service.mojom | 19 +++++++
 3 files changed, 65 insertions(+)

diff --git a/services/network/public/mojom/network_service.mojom b/services/network/public/mojom/network_service.mojom
index 00000000..11111111 100644
--- a/services/network/public/mojom/network_service.mojom
+++ b/services/network/public/mojom/network_service.mojom
@@ -26,6 +26,7 @@
 import "services/network/public/mojom/network_context.mojom";
 import "services/network/public/mojom/network_interface.mojom";
 import "services/network/public/mojom/network_interface_change_listener.mojom";
+import "services/network/public/mojom/tls_fingerprint.mojom";
 import "services/network/public/mojom/network_param.mojom";
 import "services/network/public/mojom/network_quality_estimator_manager.mojom";
@@ -483,5 +483,24 @@
   // Enables or disables TLS 1.3 Early Data.
   SetTLS13EarlyDataEnabled(bool enabled);

+  // Sets a custom TLS ClientHello fingerprint for all subsequent SSL
+  // connections in this network service process.
+  // Pass enabled=true to activate; min_version/max_version of 0 mean "keep
+  // Chromium default".  Empty arrays mean "keep BoringSSL defaults".
+  SetTLSFingerprint(
+      uint16 min_version,
+      uint16 max_version,
+      array<uint16> cipher_suites,
+      array<uint16> supported_groups,
+      array<uint8>  ec_point_formats,
+      array<uint16> extension_order,
+      bool permute_extensions,
+      bool enabled) => ();
+
+  // Reverts to Chromium default TLS behaviour, undoing SetTLSFingerprint.
+  ResetTLSFingerprint() => ();
+
 };
diff --git a/services/network/network_service.h b/services/network/network_service.h
index 00000000..11111111 100644
--- a/services/network/network_service.h
+++ b/services/network/network_service.h
@@ -188,6 +188,15 @@
   void SetTLS13EarlyDataEnabled(bool enabled) override;

+  void SetTLSFingerprint(uint16_t min_version,
+                         uint16_t max_version,
+                         const std::vector<uint16_t>& cipher_suites,
+                         const std::vector<uint16_t>& supported_groups,
+                         const std::vector<uint8_t>& ec_point_formats,
+                         const std::vector<uint16_t>& extension_order,
+                         bool permute_extensions,
+                         bool enabled,
+                         SetTLSFingerprintCallback callback) override;
+  void ResetTLSFingerprint(ResetTLSFingerprintCallback callback) override;
+
   void StartNetLogBounded(base::File file,
diff --git a/services/network/network_service.cc b/services/network/network_service.cc
index 00000000..11111111 100644
--- a/services/network/network_service.cc
+++ b/services/network/network_service.cc
@@ -76,6 +76,7 @@
 #include "net/nqe/network_quality_estimator.h"
 #include "net/socket/client_socket_pool_manager.h"
 #include "net/ssl/ssl_key_logger_impl.h"
+#include "net/ssl/tls_fingerprint_config.h"
 #include "net/url_request/url_request_context.h"
 #include "services/network/dns_config_change_manager.h"
@@ -1313,4 +1313,41 @@
 void NetworkService::SetTpcdMetadataGrants(
     const std::vector<ContentSettingPatternSource>& settings) {
   tpcd_metadata_manager_->SetGrants(settings);
 }
+
+void NetworkService::SetTLSFingerprint(
+    uint16_t min_version,
+    uint16_t max_version,
+    const std::vector<uint16_t>& cipher_suites,
+    const std::vector<uint16_t>& supported_groups,
+    const std::vector<uint8_t>& ec_point_formats,
+    const std::vector<uint16_t>& extension_order,
+    bool permute_extensions,
+    bool enabled,
+    SetTLSFingerprintCallback callback) {
+  net::TLSFingerprintParams params;
+  params.min_version       = min_version;
+  params.max_version       = max_version;
+  params.cipher_suites     = cipher_suites;
+  params.supported_groups  = supported_groups;
+  params.ec_point_formats  = ec_point_formats;
+  params.extension_order   = extension_order;
+  params.permute_extensions = permute_extensions;
+  params.enabled           = enabled;
+  net::TLSFingerprintManager::GetInstance()->SetParams(params);
+  std::move(callback).Run();
+}
+
+void NetworkService::ResetTLSFingerprint(
+    ResetTLSFingerprintCallback callback) {
+  net::TLSFingerprintManager::GetInstance()->Reset();
+  std::move(callback).Run();
+}
+
 }  // namespace network

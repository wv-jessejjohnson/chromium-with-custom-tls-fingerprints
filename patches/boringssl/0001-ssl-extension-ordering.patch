From: Custom TLS Fingerprint <noreply@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] ssl: add SSL_set_extension_order() API for fixed ClientHello extension order

Adds a per-connection API that lets callers specify the exact order in which
TLS extensions are emitted in the ClientHello.  This is used by the Chromium
TLS fingerprint spoofing layer to match the extension order of target browsers.

When ssl->config->custom_extension_order is set on an SSL*:
  1. ssl_setup_extension_permutation builds a deterministic permutation from
     the order array (extensions in the array are emitted first, in listed
     order; remaining extensions follow in their default order).
  2. The existing permutation loop in ssl_add_clienthello_tlsext then uses
     this permutation unchanged.

If SSL_set_permute_extensions(ssl, 1) is also set, random permutation wins
and custom_extension_order is ignored.

Files changed:
  include/openssl/ssl.h — declare SSL_set_extension_order()
  ssl/internal.h        — add custom_extension_order field to SSL_CONFIG
  ssl/ssl_lib.cc        — implement SSL_set_extension_order()
  ssl/extensions.cc     — honour custom order in ssl_setup_extension_permutation
---
 include/openssl/ssl.h |  9 +++++++++
 ssl/extensions.cc     | 33 +++++++++++++++++++++++++++++++++
 ssl/internal.h        |  5 +++++
 ssl/ssl_lib.cc        | 16 ++++++++++++++++
 4 files changed, 63 insertions(+)

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 00000000..11111111 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5145,7 +5145,16 @@
 // SSL_set_permute_extensions configures whether sockets on |ssl| should
 // permute extensions. For now, this is only implemented for the ClientHello.
 OPENSSL_EXPORT void SSL_set_permute_extensions(SSL *ssl, int enabled);

+// SSL_set_extension_order configures a fixed ClientHello extension send order.
+// |order| is an array of |num| IANA extension type values. Extensions whose
+// type appears in |order| are emitted first (in listed order); remaining
+// extensions follow in their default order. Pass NULL/0 to clear.
+// If SSL_set_permute_extensions(ssl, 1) is also active, permutation wins.
+// Returns 1 on success, 0 if |ssl| has no config.
+OPENSSL_EXPORT int SSL_set_extension_order(SSL *ssl, const uint16_t *order,
+                                            size_t num);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with |ssl|.
 OPENSSL_EXPORT size_t SSL_max_seal_overhead(const SSL *ssl);

diff --git a/ssl/internal.h b/ssl/internal.h
index 11111111..22222222 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3364,4 +3364,9 @@
   // alps_use_new_codepoint if set indicates we use new ALPS extension codepoint
   // to negotiate and convey application settings.
   bool alps_use_new_codepoint : 1;
+
+  // custom_extension_order is the caller-specified ClientHello extension order
+  // (IANA type values). Empty = use BoringSSL default order.
+  // Mutually exclusive with permute_extensions; permute_extensions wins.
+  Array<uint16_t> custom_extension_order;
 };

diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 22222222..33333333 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -2995,10 +2995,26 @@
 void SSL_set_permute_extensions(SSL *ssl, int enabled) {
   if (!ssl->config) {
     return;
   }
   ssl->config->permute_extensions = !!enabled;
 }

+int SSL_set_extension_order(SSL *ssl, const uint16_t *order, size_t num) {
+  if (!ssl->config) {
+    return 0;
+  }
+  ssl->config->custom_extension_order = Array<uint16_t>();
+  if (order != nullptr && num > 0) {
+    Array<uint16_t> arr;
+    if (!arr.InitForOverwrite(num)) {
+      return 0;
+    }
+    OPENSSL_memcpy(arr.data(), order, num * sizeof(uint16_t));
+    ssl->config->custom_extension_order = std::move(arr);
+  }
+  return 1;
+}
+
 int32_t SSL_get_ticket_age_skew(const SSL *ssl) {
   return ssl->s3->ticket_age_skew;
 }

diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 33333333..44444444 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3722,4 +3722,37 @@
 bool ssl_setup_extension_permutation(SSL_HANDSHAKE *hs) {
+  // If a custom extension order is specified and random permutation is not
+  // active, build a deterministic permutation from the custom order.
+  if (!hs->config->custom_extension_order.empty() &&
+      !hs->config->permute_extensions) {
+    static_assert(kNumExtensions <= UINT8_MAX,
+                  "extension_permutation type is too small");
+    Array<uint8_t> permutation;
+    if (!permutation.InitForOverwrite(kNumExtensions)) {
+      return false;
+    }
+    bool placed[kNumExtensions] = {};
+    size_t out = 0;
+    // Emit extensions in caller-specified order first.
+    for (size_t k = 0; k < hs->config->custom_extension_order.size(); k++) {
+      const uint16_t type = hs->config->custom_extension_order[k];
+      for (size_t j = 0; j < kNumExtensions; j++) {
+        if (kExtensions[j].value == type && !placed[j]) {
+          permutation[out++] = static_cast<uint8_t>(j);
+          placed[j] = true;
+          break;
+        }
+      }
+    }
+    // Append remaining extensions in default order.
+    for (size_t j = 0; j < kNumExtensions; j++) {
+      if (!placed[j]) {
+        permutation[out++] = static_cast<uint8_t>(j);
+      }
+    }
+    hs->extension_permutation = std::move(permutation);
+    return true;
+  }
+
   if (!hs->config->permute_extensions) {
     return true;
   }
